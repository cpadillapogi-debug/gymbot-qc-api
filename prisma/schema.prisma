// GymBot QC API — Prisma schema
// Mirrors the shapes your frontend already uses in js/storage.js,
// so the migration off localStorage is a lift-and-shift, not a redesign.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  GYM_OWNER
  DEVELOPER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role
  gym          Gym?     @relation("GymOwner")
  createdAt    DateTime @default(now())
  lastLoginAt  DateTime?

  auditEntries AuditLogEntry[] @relation("PerformedBy")

  @@map("users")
}

model Gym {
  id        String    @id @default(cuid())
  name      String
  owner     User      @relation("GymOwner", fields: [ownerId], references: [id])
  ownerId   String    @unique
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  auditEntries   AuditLogEntry[]
  leads          Lead[]
  conversations  Conversation[]
  gcashPayments  GcashPayment[]
  subscription   Subscription?
  settings       GymSettings?
  platformConfig GymPlatformConfig?

  @@map("gyms")
}

// One row per gym, lazily created on first read by
// services/subscription.js's getSubscription() — mirrors the frontend's
// subscription-service.js state machine exactly (same constants, same
// transition rules) so this is a faithful server-side port, not a
// redesign. planId/status/dates are the server's own source of truth now;
// the frontend's localStorage copy only remains authoritative for the
// Developer sales-demo gym (DEMO_GYM_ID), which has no row here at all.
model Subscription {
  id                 String    @id @default(cuid())
  gym                Gym       @relation(fields: [gymId], references: [id])
  gymId              String    @unique
  planId             String    @default("pro")
  status             String    @default("trialing")
  statusSince        DateTime  @default(now())
  trialEndDate       DateTime
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  nextBillingDate    DateTime?
  canceledAt         DateTime?
  requestedPlanId    String?
  upgradeRequestedAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status])
  @@map("subscriptions")
}

// Structured per-gym Business Settings — mirrors
// DEFAULT_BUSINESS_SETTINGS in the frontend's config.js field-for-field
// (see gym-settings-service.js). One row per gym, lazily created with
// these defaults on first read.
model GymSettings {
  id                 String   @id @default(cuid())
  gym                Gym      @relation(fields: [gymId], references: [id])
  gymId              String   @unique
  gymName            String   @default("")
  logoFileName       String   @default("")
  address            String   @default("")
  contactNumber      String   @default("")
  facebookUrl        String   @default("")
  instagramUrl       String   @default("")
  hours              String   @default("")
  membershipFee      String   @default("")
  walkInFee          String   @default("")
  studentDiscount    String   @default("")
  ptRate             String   @default("")
  parkingAvailable   String   @default("unspecified")
  welcomeMessage     String   @default("")
  faqs               Json     @default("[]")
  description        String   @default("")
  trainerAvailable   String   @default("unspecified")
  freeTrialAvailable String   @default("unspecified")
  updatedAt          DateTime @updatedAt

  @@map("gym_settings")
}

// Business-type + globalization config — mirrors gym-config-service.js's
// record shape exactly (businessTypeId/countryCode/currencyCode/
// languageCode). Valid ID/code lists are enforced server-side in
// services/gymPlatformConfig.js against the same catalog the frontend's
// config-business-types.js / config-globalization.js ship.
model GymPlatformConfig {
  id             String   @id @default(cuid())
  gym            Gym      @relation(fields: [gymId], references: [id])
  gymId          String   @unique
  businessTypeId String   @default("traditional_gym")
  countryCode    String   @default("PH")
  currencyCode   String   @default("PHP")
  languageCode   String   @default("fil")
  updatedAt      DateTime @updatedAt

  @@map("gym_platform_configs")
}

// Generic key/value store for small platform-wide settings that don't
// warrant their own table — currently just maintenance mode. value is
// JSON so a future setting can hold a structured payload without a new
// migration.
model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

// One customer conversation thread per gym. `leadId` is optional and
// set once a lead gets captured mid-conversation (captureLead()'s
// dedup-by-phone can happen after messages have already come in) —
// it is NOT required up front, since plenty of conversations never
// turn into a lead at all (a customer just asking hours, say).
model Conversation {
  id            String    @id @default(cuid())
  gym           Gym       @relation(fields: [gymId], references: [id])
  gymId         String
  lead          Lead?     @relation(fields: [leadId], references: [id])
  leadId        String?
  customerName  String    @default("")
  customerPhone String    @default("")
  // "ai" | "staff" — who's currently answering. Drives the "Take
  // over" / "Return to AI" toggle in the (future) inbox UI.
  handledBy     String    @default("ai")
  // "open" | "resolved" — lets an owner clear their inbox without
  // deleting history.
  status        String    @default("open")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastMessageAt DateTime  @default(now())

  messages Message[]

  @@index([gymId])
  @@index([gymId, status])
  @@map("conversations")
}

// "customer" | "bot" | "staff" — kept as a free-form string for the
// same reason Lead.status is: matches how chat-ui.js already tags
// messages by role, no separate enum to keep in sync.
model Message {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  conversationId String
  role           String
  text           String
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@map("messages")
}

// Mirrors the lead shape from js/services/leads-service.js exactly —
// LEAD_STATUSES/LEAD_SOURCES stay free-form strings (not enums) since
// the frontend already owns and validates that list in config.js;
// duplicating it here as a Postgres enum would mean two places to
// update every time a status/source is added.
model Lead {
  id                  String   @id @default(cuid())
  gym                 Gym      @relation(fields: [gymId], references: [id])
  gymId               String
  name                String
  phone               String
  email               String   @default("")
  goal                String   @default("")
  preferredTime       String   @default("")
  source              String   @default("Website")
  status              String   @default("New")
  notes               String   @default("")
  conversationSummary String   @default("")
  statusHistory       Json     @default("[]")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  lastActivityAt      DateTime @default(now())

  conversations Conversation[]

  // Speeds up findLeadByPhone-equivalent lookups and the per-gym list
  // view, which are the two hot paths (captureLead's dedup check, and
  // GET /leads).
  @@index([gymId])
  @@index([gymId, phone])
  @@map("leads")
}

// Manual GCash "owner uploads proof, Developer eyeballs it and
// approves/rejects" flow — same honesty as the frontend's
// gcash-payment-service.js header comment: there is no real payment
// gateway here, no verified transaction, just a record of what the
// owner claims and what the Developer decided.
//
// SCOPE NOTE: this model intentionally does NOT reference a separate
// Plan, Invoice, or Commission table — those stay frontend-only
// concepts (invoice-service.js / commission-service.js are not ported
// server-side). It DOES sit next to a real Subscription table now:
// amount/planId/planName/billingPeriod on a created row are always
// computed server-side in routes/billing.js's POST /billing/gcash
// handler from the gym's own stored Subscription (getAmountDue()/
// getPlan()) — never accepted from the request body. These columns
// exist to freeze a durable record of what was charged at submission
// time, not to be client-writable.
model GcashPayment {
  id                  String    @id @default(cuid())
  gym                 Gym       @relation(fields: [gymId], references: [id])
  gymId               String
  planId              String
  planName            String
  amount              Float
  billingPeriodStart  DateTime?
  billingPeriodEnd    DateTime?
  proofImageDataUrl   String
  proofFileName       String    @default("")
  reference           String    @default("")
  note                String    @default("")
  // "submitted" | "approved" | "rejected" — matches config.js's
  // GCASH_PAYMENT_STATUS on the frontend.
  status              String    @default("submitted")
  submittedAt         DateTime  @default(now())
  decidedAt           DateTime?
  decidedByEmail      String?
  rejectionReason     String?
  internalNote        String    @default("")

  @@index([gymId])
  @@index([status])
  @@map("gcash_payments")
}

// Matches config.js's AUDIT_ACTIONS constants as free-form strings for
// now — tighten to an enum once the action list is finalized.
model AuditLogEntry {
  id            String   @id @default(cuid())
  action        String
  gym           Gym?     @relation(fields: [gymId], references: [id])
  gymId         String?
  performedBy   User?    @relation("PerformedBy", fields: [performedById], references: [id])
  performedById String?
  previousValue String?
  newValue      String?
  note          String?
  createdAt     DateTime @default(now())

  @@map("audit_log_entries")
}